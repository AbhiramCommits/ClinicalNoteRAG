# ClinicalNoteRAG environment. Copy to .env and edit as needed.
# All defaults are offline-safe and use synthetic data only.

# Reproducibility
SEED=42

# Paths
ARTIFACT_DIR=artifacts
DATA_DIR=data

# Embeddings: auto | sentence-transformers | hashing
# auto tries all-MiniLM-L6-v2 and falls back to deterministic hashing.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=512

# Generation: auto | extractive | hf-local | openai
# auto resolves to the deterministic extractive backend unless
# CLINICAL_RAG_ENABLE_HF=1 (or CLINICAL_RAG_USE_OPENAI=1 with a key).
LLM_BACKEND=auto
CLINICAL_RAG_ENABLE_HF=0
CLINICAL_RAG_USE_OPENAI=0
LLM_PRIMARY_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_FALLBACK_MODEL=google/flan-t5-base

# Vector store: faiss | pgvector
VECTOR_BACKEND=faiss
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/clinicalnoterag

# Retrieval / grounding
RETRIEVAL_K=5
RRF_K=60
ABSTENTION_THRESHOLD=0.012
CHUNK_TARGET_TOKENS=256
CHUNK_OVERLAP_TOKENS=32

# Commercial API baseline (leave empty to skip; no numbers are invented)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COST_PER_1K_INPUT_TOKENS_USD=0.00015
COST_PER_1K_OUTPUT_TOKENS_USD=0.0006

# LoRA
MAX_STEPS=12
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj

# Service
API_PORT=8000
POSTGRES_PORT=5433
